{
  "name": "themeflip",
  "version": "0.1.3",
  "license": "MIT",
  "description": "A lightweight React theme toggle for light, dark, and system themes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disfordave/themeflip.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
